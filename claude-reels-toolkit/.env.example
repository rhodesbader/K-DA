# Copiez ce fichier en .env (jamais versionné) UNIQUEMENT si vous voulez changer les défauts.
# Aucune clé API n'est nécessaire : tout le traitement est local.
# Le toolkit lit ces variables depuis l'environnement (export / set), pas depuis .env automatiquement.

# Dossier de travail (défaut : ./reels-workspace)
REELKIT_WORKSPACE=

# Modèle faster-whisper : tiny | base | small | medium | large-v3, ou chemin d'un modèle local
REELKIT_WHISPER_MODEL=small

# Dossier de cache des modèles Whisper (défaut : cache Hugging Face)
REELKIT_WHISPER_MODEL_DIR=
